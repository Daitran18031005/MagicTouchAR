# Copy this file to .env (same folder) for machine-local settings. .env is git-ignored.
# Empty value = use the default.

# Full path to the Python interpreter used to run the hand tracker.
# Empty = use .venv\Scripts\pythonw.exe created by Tools\setup_python_env.bat.
PYTHON_EXE=

# UDP ports between Tools/mediapipe_streamer.py and Unity (defaults 9050 / 9051).
LANDMARK_UDP_PORT=9050
VIDEO_UDP_PORT=9051

# Webcam index passed to the streamer (--camera). 0 = first camera.
CAMERA_INDEX=0

# Editor input mode: ar | mouse. Empty = scene value (AR). The menu
# Tools > Magic Touch > Switch Input stores a per-machine choice that takes precedence.
# Only AR starts the Python tracker. Player builds always use AR.
INPUT_MODE=
